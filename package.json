{
  "name": "pi-takt-bridge",
  "version": "0.1.0",
  "description": "Run TAKT in a live terminal panel inside Pi.",
  "type": "module",
  "license": "MIT",
  "author": "eiei114",
  "keywords": [
    "pi-package",
    "pi",
    "takt",
    "acp",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eiei114/pi-takt-bridge"
  },
  "bugs": {
    "url": "https://github.com/eiei114/pi-takt-bridge/issues"
  },
  "homepage": "https://github.com/eiei114/pi-takt-bridge#readme",
  "files": [
    "extensions/",
    "lib/",
    "docs/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/takt-state.test.mjs tests/takt-widget.test.mjs tests/takt-acp-client.test.mjs tests/takt-live-panel.test.mjs",
    "pack:check": "npm pack --dry-run",
    "publish:guard": "node scripts/check-no-npm-token.mjs",
    "ci": "npm run typecheck && npm test && npm run pack:check && npm run publish:guard"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "overrides": {
    "protobufjs": ">=7.6.3 <8.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  }
}
